set shell := ["bash", "-cu"]

# List setup recipes.
default:
    @just --justfile ../justfile --working-directory .. --list setup

# Set the machine profile and device name in /etc/environment ($PREFIX/etc/environment in Termux).
init-system:
    bash setup.sh init-system

# Install the profile's package baseline (--list prints it, --diff shows packages missing from it).
packages *flag:
    bash setup.sh packages {{ flag }}

# Link profile-appropriate dotfiles (--relink fixes wrong symlinks, --adopt also backs up real files).
links *flag:
    bash setup.sh links {{ flag }}

# Install and configure zsh and Antidote.
shell:
    bash setup.sh shell

# Install Neovim 0.11+ and link its configuration.
nvim:
    bash setup.sh nvim

# Install tmux, TPM, and link the tmux configuration.
tmux:
    bash setup.sh tmux

# Install Node.js LTS (fnm, or pkg in Termux) and the tree-sitter CLI.
node:
    bash setup.sh node

# Install uv for Python tools and virtual environments (home, work and mobile).
python:
    bash setup.sh python

# Add the shared ssh defaults and ~/.ssh/config.d to ~/.ssh/config without replacing it.
ssh:
    bash setup.sh ssh

# Source the tiny bashrc fallback from ~/.bashrc without replacing it.
bash:
    bash setup.sh bash

# Install Docker Engine from Docker's apt repository (remote profile).
docker:
    bash setup.sh docker

# Install the WSL config templates (work profile, WSL only).
wsl:
    bash setup.sh wsl

# Harden sshd, automatic updates and the firewall; asks before each change (remote profile).
harden:
    bash setup.sh harden

# Report missing tools, wrong links and drift for this machine's profile.
doctor:
    bash setup.sh doctor

# Configure Termux: settings, font, widget shortcuts, boot script and sshd (Termux only).
termux:
    bash setup.sh termux

# Install and link the Hyprland desktop (home profile only).
desktop:
    bash setup.sh desktop

# Install the home-profile login, lock, and sleep configuration.
manual-lock:
    bash setup.sh manual-lock

# Run every setup task the machine's profile includes.
all:
    bash setup.sh all

# Run isolated setup tests.
test:
    bash test.sh
