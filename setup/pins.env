# Pinned versions and checksums for everything setup downloads. Plain KEY=value so both
# bash (setup/) and zsh (shell/zsh/core/plugins.zsh) can source it. `just updates` reports
# newer upstream releases; bump a pin together with its checksum, then run `just test-container`.

# Neovim release tarball (github.com/neovim/neovim)
NVIM_VERSION=0.12.5
NVIM_SHA256_X86_64=bce0f56eda1f1b1db6eee8f4133d7a38813ea07933837dd1777411ca384c6875
NVIM_SHA256_ARM64=1aa5ca085249580ae0f91eb14f27ec0919773ff2d99a163d03f3d6c21ac29725

# fnm release zip (github.com/Schniz/fnm): fnm-linux.zip and fnm-arm64.zip
FNM_VERSION=1.39.0
FNM_SHA256_X86_64=7807664f39d39fc518da1c35ba0181e4b3267603c4b1dedeb4b5fc6ae440a224
FNM_SHA256_ARM64=4eaff58b2c5bf30d0934027572dd0b5bbb60d2a1af309230b53662d4b1d45599

# uv release tarball (github.com/astral-sh/uv)
UV_VERSION=0.12.23
UV_SHA256_X86_64=9167d72b3319674b6303c4cbe071854bba13ebdf3d76b1a7cbdc175471fb66d6
UV_SHA256_ARM64=6524bd338177ed50d035d39354e12545e993bbeba2ecbddf0480c5b3a81d313f

# Git checkouts (commit SHAs). Zsh plugins are pinned with pin: in shell/plugins/*.txt.
