# Per-machine settings sourced by every zsh (see shell/zsh/core/env.zsh). Copy to .env.
# Machine identity (WHC_PROFILE, WHC_DEVICE) lives in /etc/environment, not here.

# Directory shortcuts (cdd, cdp, cdi) and the tmux project picker
WHC_PROJECTS_DIR=$HOME/projects # `cdp [name]` goes here or to a subdirectory
WHC_INFRA_DIR=$HOME/infra # `cdi [name]`
# WHC_DOTFILES_DIR cannot be set here (.env lives inside it); export it before the shell starts to relocate the repo (default ~/dotfiles).

# Work profile: the address used for commits on the work machine. It applies to every repo there
# unless a repo sets its own with `git config --local user.email`.
WHC_WORK_EMAIL=

# tmux status bar, home profile: Claude's usage is read from Anthropic's OAuth usage endpoint with
# the token Claude Code keeps in ~/.claude/.credentials.json. Set this only to replace that with
# your own command, which must print the remaining "5-hour%/weekly%" (for example "72%/85%").
WHC_CLAUDE_USAGE_CMD=
