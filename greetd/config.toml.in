[terminal]
# The VT to run the greeter on. Can be "next", "current" or a number
# designating the VT.
vt = 1

# The default session, also known as the greeter.
[default_session]

# Rendered by `just setup manual-lock` (@USER@ is the installing user, @SESSION_COMMAND@ is
# `uwsm start hyprland.desktop` when uwsm is installed, else `start-hyprland`).
# Start the Hyprland session from tuigreet; customize its options here.
command = "tuigreet --remember --user @USER@ --cmd '@SESSION_COMMAND@'"

# The user to run the command as. The privileges this user must have depends
# on the greeter. A graphical greeter may for example require the user to be
# in the `video` group.
user = "greeter"
