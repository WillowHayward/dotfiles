def default_root() -> Path:
    if (TOOL_DIR.parent / "shell/.tmux.conf").exists():  # vendored in a dotfiles checkout: render into it
        return TOOL_DIR.parent
    return Path(os.environ.get("WHC_DOTFILES_DIR") or Path.home() / "dotfiles").expanduser()


def pick_theme(themes, tid):
    if tid not in themes:
        sys.exit(f"whc-theme: unknown theme {tid!r}; `whc-theme list` shows them")
    return themes[tid]


def check_variant(t, variant):
    if variant in ("auto", "base"):
        return variant
    if variant not in t.get("devices", {}):
        sys.exit(f"whc-theme: {t['id']} has no variant {variant!r} (machines: {', '.join(t.get('devices', {}))})")
    return variant


def current_theme_id(root: Path, themes) -> str:
    for p in (state_path(), repo_state_path(root)):
        tid = read_toml_simple(p).get("theme")
        if tid in themes:
            return tid
    return "meadow-night"


def selected_targets(spec: str | None, ctx: Ctx | None = None) -> list[Target]:
    """Targets for --targets: names, `machine` (installed apps outside the dotfiles), `all`, or the dotfiles set."""
    if not spec:
        return [t for t in TARGETS.values() if t.committed]
    out: list[Target] = []
    for name in [s.strip() for s in spec.split(",") if s.strip()]:
        if name == "all":
            group = [t for t in TARGETS.values() if t.kind not in ("print", "system")]
        elif name == "machine":
            group = [t for t in TARGETS.values() if t.detect and (ctx is None or t.detect(ctx))]
        elif name == "dotfiles":
            group = [t for t in TARGETS.values() if t.committed]
        elif name in TARGETS:
            group = [TARGETS[name]]
        else:
            sys.exit(f"whc-theme: unknown target {name!r}; see `whc-theme targets`")
        out += [t for t in group if t not in out]
    return out


