# ---- GNOME/libadwaita settings (gsettings: colour scheme and accent) ----
ADW_ACCENTS = {"blue": "#3584E4", "teal": "#2190A4", "green": "#3A944A", "yellow": "#C88800", "orange": "#ED5B00",
               "red": "#E62D42", "pink": "#D56199", "purple": "#9141AC", "slate": "#6F8396"}


def hue_sat(h: str) -> tuple[float, float]:
    r, g, b = (x / 255 for x in rgb(h))
    mx, mn = max(r, g, b), min(r, g, b)
    if mx == mn:
        return 0.0, 0.0
    d = mx - mn
    s = d / mx
    if mx == r:
        hh = (g - b) / d % 6
    elif mx == g:
        hh = (b - r) / d + 2
    else:
        hh = (r - g) / d + 4
    return hh * 60, s


def adw_accent(colour: str) -> str:
    """The libadwaita named accent nearest in hue (slate for greys)."""
    env = os.environ.get("WHC_GTK_ACCENT")
    if env in ADW_ACCENTS:
        return env
    h, sat = hue_sat(colour)
    if sat < 0.15:
        return "slate"

    def dist(name):
        ah, _ = hue_sat(ADW_ACCENTS[name])
        d = abs(h - ah) % 360
        return min(d, 360 - d)
    return min((n for n in ADW_ACCENTS if n != "slate"), key=dist)


def gnome_detect(ctx: Ctx) -> bool:
    if not shutil.which("gsettings"):
        return False
    try:
        r = subprocess.run(["gsettings", "list-keys", "org.gnome.desktop.interface"], capture_output=True, text=True,
                           timeout=10)
    except (OSError, subprocess.TimeoutExpired):
        return False
    return r.returncode == 0 and "color-scheme" in r.stdout


