# --- colour helpers -------------------------------------------------------------------------------
def rgb(h: str) -> tuple[int, int, int]:
    h = h.lstrip("#")
    return int(h[0:2], 16), int(h[2:4], 16), int(h[4:6], 16)


def hexc(c) -> str:
    return "#" + "".join(f"{max(0, min(255, round(x))):02X}" for x in c)


def mix(a: str, b: str, t: float) -> str:
    ra, rb = rgb(a), rgb(b)
    return hexc(x + (y - x) * t for x, y in zip(ra, rb))


def nohash(h: str) -> str:
    return h.lstrip("#").upper()


def lower(h: str) -> str:
    return h.lower()


def rgba(h: str, alpha: str = "ff") -> str:
    return f"rgba({nohash(h).lower()}{alpha})"


def luminance(h: str) -> float:
    def lin(c):
        c /= 255
        return c / 12.92 if c <= 0.04045 else ((c + 0.055) / 1.055) ** 2.4
    r, g, b = (lin(x) for x in rgb(h))
    return 0.2126 * r + 0.7152 * g + 0.0722 * b


def contrast(a: str, b: str) -> float:
    la, lb = sorted((luminance(a), luminance(b)), reverse=True)
    return (la + 0.05) / (lb + 0.05)


# --- data -------------------------------------------------------------------------------------------
def data_dir() -> Path:
    env = os.environ.get("WHC_THEME_DATA")
    path = Path(env).expanduser() if env else TOOL_DIR / "data"
    if not path.is_dir():
        sys.exit(f"whc-theme: no theme data in {path} (set WHC_THEME_DATA, or `whc-theme data-sync --from <whc-theme>`)")
    return path


def load_themes() -> dict[str, dict]:
    path = data_dir()
    order = json.loads((path / "index.json").read_text())["themes"] if (path / "index.json").exists() else None
    files = [path / f"{t}.json" for t in order] if order else sorted(path.glob("*.json"))
    themes = [json.loads(f.read_text()) for f in files if f.name != "index.json"]
    return {t["id"]: t for t in themes}


# --- resolution ---------------------------------------------------------------------------------------
@dataclass
class Pal:
    """One theme resolved for one machine (or for none: device == None)."""
    theme: dict
    device: str | None
    bg: str = ""
    fg: str = ""
    comment: str = ""
    selection: str = ""
    cursor: str = ""
    cursor_text: str = ""
    a: dict = field(default_factory=dict)
    orange: str = ""
    purple: str = ""
    status_bg: str = ""
    status_fg: str = ""
    status2_bg: str = ""
    status2_fg: str = ""
    ui: dict = field(default_factory=dict)
    syntax: dict = field(default_factory=dict)

    @property
    def id(self):
        return self.theme["id"]

    @property
    def name(self):
        return self.theme["name"] + (f" · {self.device}" if self.device else "")

    @property
    def dark(self):
        return self.theme["mode"] == "dark"

    @property
    def tinted(self):
        """True when this theme re-tints the background per machine (the bespoke WHC palettes)."""
        return bool(self.device) and "background" in self.theme["devices"].get(self.device, {})

    def seq16(self):
        return [self.a[k] for k in ORDER8] + [self.a["bright_" + k] for k in ORDER8]

    @property
    def on_mid(self):
        """Text on a mid-tone segment (comment-coloured): light text on dark themes, the page colour on light."""
        return self.fg if self.dark else self.bg


def resolve(t: dict, device: str | None) -> Pal:
    p = Pal(theme=t, device=device)
    p.bg, p.fg, p.comment, p.selection = t["background"], t["foreground"], t["comment"], t["selection"]
    p.cursor, p.cursor_text = t["cursor"], t.get("cursor_text", t["background"])
    p.a = dict(t["ansi"])
    p.orange, p.purple = t["orange"], t["purple"]
    p.ui, p.syntax = dict(t["ui"]), dict(t["syntax"])
    p.status_bg, p.status_fg = p.ui["accent"], p.bg
    p.status2_bg, p.status2_fg = p.selection, p.fg
    if device:
        d = t.get("devices", {}).get(device)
        if d is None:
            raise SystemExit(f"whc-theme: {t['id']} has no variant for {device!r}")
        for k in ("background", "comment", "selection", "cursor"):
            if k in d:
                setattr(p, "bg" if k == "background" else k, d[k])
        if "background" in d:
            p.cursor_text = d["background"]
        for k in ("black", "bright_black", "dim_black"):
            if k in d:
                p.a[k] = d[k]
        p.status_bg, p.status_fg = d["status_bg"], d["status_fg"]
        p.status2_bg, p.status2_fg = d.get("status2_bg", p.selection), d.get("status2_fg", p.fg)
    return p


def detect_device() -> str | None:
    d = os.environ.get("WHC_DEVICE") or socket.gethostname().split(".")[0]
    return d.lower() if d else None


# --- targets ----------------------------------------------------------------------------------------
@dataclass
class Ctx:
    theme: dict
    variant: str            # auto | base | <device>
    root: Path              # dotfiles root
    home: Path

    def pinned(self) -> str | None:
        return None if self.variant in ("auto", "base") else self.variant

    def runtime_devices(self) -> list[str]:
        """Machines a runtime-selecting target embeds."""
        if self.variant == "base":
            return []
        if self.variant == "auto":
            return [d for d in DEVICES if d in self.theme.get("devices", {})]
        return [self.variant]

    def static_device(self, shared: bool) -> str | None:
        if self.variant == "base":
            return None
        if self.variant == "auto":
            if shared:
                return None
            d = detect_device()
            return d if d in self.theme.get("devices", {}) else None
        return self.variant

    def label(self) -> str:
        return f"{self.theme['id']} ({self.variant})"


@dataclass
class Out:
    path: Path | None        # None: stdout only (or only `run`)
    content: str
    block: bool = False      # replace the managed block inside an existing file instead of the whole file
    note: str = ""
    comment: tuple = ("#", "")   # managed-block marker comment: (open, close)
    backup: bool = False     # keep a one-time <file>.whc-backup of a file whc-theme did not write
    create: bool = False     # a managed block may create its file (otherwise the file must exist)
    run: list = field(default_factory=list)   # commands (argv lists) `apply` runs instead of/after writing


def whc_written(text: str) -> bool:
    return "whc-theme" in text


@dataclass
class Target:
    name: str
    desc: str
    kind: str                # runtime | shared | local | print
    committed: bool          # wired into the dotfiles (the default `apply` set)
    render: Callable[[Ctx], list[Out]]
    wiring: str = ""
    detect: Callable[[Ctx], bool] | None = None   # set: part of the `machine` group, applied when it returns True


TARGETS: dict[str, Target] = {}


def target(name, desc, kind, committed=False, wiring="", detect=None):
    def deco(fn):
        TARGETS[name] = Target(name, desc, kind, committed, fn, wiring, detect)
        return fn
    return deco


def header(ctx: Ctx, prefix="#", extra="") -> str:
    lines = [f"{prefix} Generated by whc-theme {VERSION}: {ctx.theme['name']} ({ctx.theme['id']}), variant {ctx.variant}.",
             f"{prefix} Do not edit; change the theme with `whc-theme apply <theme>`. {extra}".rstrip()]
    return "\n".join(lines) + "\n"


def pal_static(ctx: Ctx, shared: bool) -> Pal:
    return resolve(ctx.theme, ctx.static_device(shared))


# ---- foot (managed block in foot/foot.ini) ----
def foot_lines(p: Pal) -> list[str]:
    a = p.a
    sect = "colors-dark" if p.dark else "colors-light"
    lines = ["[main]", f"initial-color-theme={'dark' if p.dark else 'light'}", f"[{sect}]",
             f"cursor={nohash(p.cursor_text)} {nohash(p.cursor)}",
             f"foreground={nohash(p.fg)}", f"background={nohash(p.bg)}",
             f"selection-foreground={nohash(p.fg)}", f"selection-background={nohash(p.selection)}",
             f"urls={nohash(a['cyan'])}"]
    lines += [f"regular{i}={nohash(a[k])}" for i, k in enumerate(ORDER8)]
    lines += [f"bright{i}={nohash(a['bright_' + k])}" for i, k in enumerate(ORDER8)]
    lines += [f"dim{i}={nohash(a['dim_' + k])}" for i, k in enumerate(ORDER8) if "dim_" + k in a]
    return lines


@target("foot", "foot terminal colours", "shared", committed=True,
        wiring="managed block at the end of foot/foot.ini (foot -C validates it)")
def t_foot(ctx):
    p = pal_static(ctx, shared=True)
    return [Out(ctx.root / "foot/foot.ini", "\n".join(foot_lines(p)) + "\n", block=True)]


# ---- mako (managed block in mako/config) ----
@target("mako", "mako notification colours", "shared", committed=True,
        wiring="managed block in mako/config, after the global options and before the [urgency] sections")
def t_mako(ctx):
    p = pal_static(ctx, shared=True)
    body = [f"background-color={p.ui['surface']}", f"text-color={p.fg}", f"border-color={p.status_bg if p.device else p.purple}",
            f"progress-color=over {p.selection}", "", "[urgency=low]", f"border-color={p.comment}", "",
            "[urgency=critical]", f"border-color={p.a['red']}"]
    return [Out(ctx.root / "mako/config", "\n".join(body) + "\n", block=True)]


# ---- termux (whole file) ----
@target("termux", "Termux colors.properties", "shared", committed=True,
        wiring="termux/colors.properties (linked to ~/.termux/ by `just setup termux`; run termux-reload-settings)")
def t_termux(ctx):
    p = pal_static(ctx, shared=True)
    lines = [f"background={p.bg}", f"foreground={p.fg}", f"cursor={p.cursor}"]
    lines += [f"color{i}={c}" for i, c in enumerate(p.seq16())]
    return [Out(ctx.root / "termux/colors.properties", header(ctx) + "\n".join(lines) + "\n")]


# ---- tmux (whole file, picks the machine at load time) ----
def tmux_block(p: Pal, device_label: str, ind: str) -> list[str]:
    a = p.a
    opts = {
        "@whc_device": device_label, "@whc_status_bg": p.status_bg, "@whc_status_fg": p.status_fg,
        "@whc_session_bg": p.status2_bg if p.device else p.selection,
        "@whc_session_fg": p.status2_fg if p.device else p.fg,
        "@whc_bg": p.bg, "@whc_fg": p.fg, "@whc_comment": p.comment, "@whc_selection": p.selection,
        "@whc_accent": p.ui["accent"], "@whc_cyan": a["cyan"], "@whc_green": a["green"], "@whc_yellow": a["yellow"],
        "@whc_red": a["red"], "@whc_purple": p.purple, "@whc_orange": p.orange,
    }
    lines = [f'{ind}set -g {k} "{v}"' for k, v in opts.items()]
    border = p.status_bg if p.device else p.purple
    lines += [
        f'{ind}set -g status-style "bg={p.bg},fg={p.fg}"',
        f'{ind}setw -g window-status-style "fg={p.comment}"',
        f'{ind}setw -g window-status-activity-style "fg={a["yellow"]}"',
        f'{ind}setw -g window-status-bell-style "fg={a["red"]},bold"',
        f'{ind}set -g pane-border-style "fg={p.selection}"',
        f'{ind}set -g pane-active-border-style "fg={border}"',
        f'{ind}set -g message-style "bg={p.selection},fg={p.fg}"',
        f'{ind}set -g message-command-style "bg={p.selection},fg={a["cyan"]}"',
        f'{ind}setw -g mode-style "bg={p.selection},fg={p.fg}"',
        f'{ind}setw -g clock-mode-colour "{border}"',
        f'{ind}set -g popup-border-style "fg={border}"',
        f'{ind}set -g window-style "bg={p.bg}"',
        f'{ind}set -g window-active-style "bg={p.bg}"',
        f'{ind}set-environment -g WHC_THEME_STATUS "dim={p.comment};text={p.fg};green={a["green"]};yellow={a["yellow"]};'
        f'orange={p.orange};red={a["red"]};purple={p.purple}"',
    ]
    return lines


def lazygit_path(ctx: Ctx, device: str | None) -> str:
    return f"lazygit/whc-theme/{device or 'base'}.yml"


@target("tmux", "tmux status bar, device segment, pane tint", "runtime", committed=True,
        wiring="shell/.tmux.theme.conf, sourced by shell/.tmux.conf; layout stays in .tmux.conf and reads @whc_* options")
def t_tmux(ctx):
    devs = ctx.runtime_devices()
    out = [header(ctx), "# Colours only: ~/.tmux.conf owns the layout and refers to the @whc_* options set here.",
           "# The machine is $WHC_DEVICE, else the short hostname. Needs tmux >= 3.0 and truecolor (RGB).",
           f'set -g @whc_theme "{ctx.theme["id"]}"', 'set-environment -g WHC_THEME "' + ctx.theme["id"] + '"']
    # The lazygit file is found relative to this file (#{d:current_file} is .../shell while it is sourced).
    def lg(device):
        return ('set-environment -gF LG_CONFIG_FILE "$HOME/.config/lazygit/config.yml,#{d:current_file}/../'
                + lazygit_path(ctx, device) + '"')

    if ctx.pinned():
        d = ctx.pinned()
        out += tmux_block(resolve(ctx.theme, d), d, "")
        out.append(lg(d))
    elif devs:
        first = True
        for d in devs:
            cond = f'#{{||:#{{==:$WHC_DEVICE,{d}}},#{{&&:#{{==:$WHC_DEVICE,}},#{{==:#{{host_short}},{d}}}}}}}'
            out.append(f'{"%if" if first else "%elif"} "{cond}"')
            first = False
            out += tmux_block(resolve(ctx.theme, d), d, "  ")
            out.append("  " + lg(d))
        out.append("%else")
        out += tmux_block(resolve(ctx.theme, None), "#{host_short}", "  ")
        out.append("  " + lg(None))
        out.append("%endif")
    else:
        out += tmux_block(resolve(ctx.theme, None), "#{host_short}", "")
        out.append(lg(None))
    return [Out(ctx.root / "shell/.tmux.theme.conf", "\n".join(out) + "\n")]


# ---- zsh: p10k, prompt host segment, autosuggestions, fzf, lazygit (whole file) ----
ZSH_KEYS = ["bg", "fg", "comment", "selection", "bright_black", "status_bg", "status_fg", "status2_bg", "status2_fg"]


def zsh_values(p: Pal) -> dict:
    a = p.a
    return {"bg": p.bg, "fg": p.fg, "comment": p.comment, "selection": p.selection, "bright_black": a["bright_black"],
            "black": a["black"], "red": a["red"], "green": a["green"], "yellow": a["yellow"], "blue": a["blue"],
            "pink": a["magenta"], "cyan": a["cyan"], "purple": p.purple, "orange": p.orange,
            "status_bg": p.status_bg, "status_fg": p.status_fg, "status2_bg": p.status2_bg, "status2_fg": p.status2_fg,
            "on_mid": p.on_mid, "accent": p.ui["accent"]}


def zsh_assoc(d: dict, keys=None) -> str:
    keys = keys or list(d)
    return " ".join(f"{k} '{d[k]}'" for k in keys)


ZSH_BODY = r'''
export WHC_THEME=$whc_theme[id]

# Powerlevel10k: shell/themes/dracula-powerlevel10k/p10k.zsh spells Dracula's colours literally. Re-colour
# every POWERLEVEL9K_* parameter (and the Git formatter) by role, so the upstream file stays untouched.
() {
    emulate -L zsh -o extended_glob
    local -A plain=(
        282A36 $whc_theme[bg] F8F8F2 $whc_theme[fg] 6272A4 $whc_theme[comment] 44475A $whc_theme[selection]
        BD93F9 $whc_theme[purple] 50FA7B $whc_theme[green] F1FA8C $whc_theme[yellow] FF5555 $whc_theme[red]
        8BE9FD $whc_theme[cyan] FFB86C $whc_theme[orange] FF79C6 $whc_theme[pink]
    )
    # Text on a coloured segment: Dracula's white becomes the theme's "on mid-tone" colour (differs on light themes).
    local -A seg=("${(@kv)plain}")
    seg[F8F8F2]=$whc_theme[on_mid]
    local p v k b
    for p in ${(k)parameters[(I)POWERLEVEL9K_*]}; do
        [[ ${parameters[$p]} == scalar* ]] || continue
        v=${(P)p}
        [[ $v == *\#[[:xdigit:]](#c6)* ]] || continue
        local -A map=("${(@kv)plain}")
        if [[ $p == *_FOREGROUND ]]; then
            b=${p%_FOREGROUND}_BACKGROUND
            b=${(U)${(P)b:-}}
            [[ -n $b && $b != '#282A36' && $b != ${(U)whc_theme[bg]} ]] && map=("${(@kv)seg}")
        fi
        for k in ${(k)map}; do v=${v//(#i)\#$k/$map[$k]}; done
        typeset -g $p=$v
    done
    if (( $+functions[my_git_formatter] )); then
        v=$functions[my_git_formatter]
        for k in ${(k)seg}; do v=${v//(#i)\#$k/$seg[$k]}; done
        functions[my_git_formatter]=$v
    fi
}

# prompt.zsh uses whc_theme[status_bg]/[status_fg] for the machine segment and [bright_black]
# (the theme's readable-hint colour) for zsh-autosuggestions.

# fzf: history.zsh appends these to FZF_DEFAULT_OPTS.
export WHC_FZF_COLORS="${(L):-fg:$whc_theme[fg],bg:$whc_theme[bg],hl:$whc_theme[purple],fg+:$whc_theme[fg],bg+:$whc_theme[selection],hl+:$whc_theme[purple],info:$whc_theme[orange],prompt:$whc_theme[green],pointer:$whc_theme[pink],marker:$whc_theme[pink],spinner:$whc_theme[orange],header:$whc_theme[comment],border:$whc_theme[selection]}"

# lazygit: the hand-written config, then this machine's colours (later files win). tmux sets the same for popups.
if (( $+commands[lazygit] )); then
    () {
        local cfg=${XDG_CONFIG_HOME:-$HOME/.config}/lazygit/config.yml
        local dir=${${(%):-%x}:A:h:h:h}/lazygit/whc-theme  # this file is shell/themes/whc-theme.zsh
        local th=$dir/$whc_theme[device].yml
        [[ -r $th ]] || th=$dir/base.yml
        [[ -r $cfg && -r $th ]] && export LG_CONFIG_FILE="$cfg,$th"
    }
fi
'''


@target("zsh", "p10k prompt colours, prompt host segment, autosuggestions, fzf, lazygit selection", "runtime",
        committed=True, wiring="shell/themes/whc-theme.zsh, sourced by shell/zsh/core/prompt.zsh after the p10k theme")
def t_zsh(ctx):
    base = zsh_values(resolve(ctx.theme, None))
    lines = [header(ctx).rstrip(), "# Sourced by shell/zsh/core/prompt.zsh after the Dracula p10k theme file.",
             f"typeset -gA whc_theme=(id {ctx.theme['id']} mode {ctx.theme['mode']} device base {zsh_assoc(base)})"]
    devs = ctx.runtime_devices()
    if ctx.pinned():
        d = ctx.pinned()
        lines.append(f"whc_theme+=(device {d} {zsh_assoc(zsh_values(resolve(ctx.theme, d)), ZSH_KEYS)})")
    elif devs:
        lines.append("case ${WHC_DEVICE:-${HOST%%.*}} in")
        for d in devs:
            lines.append(f"    {d}) whc_theme+=(device {d} {zsh_assoc(zsh_values(resolve(ctx.theme, d)), ZSH_KEYS)}) ;;")
        lines.append("esac")
    return [Out(ctx.root / "shell/themes/whc-theme.zsh", "\n".join(lines) + "\n" + ZSH_BODY)]


# ---- lazygit (one file per machine; zsh/tmux pick it via LG_CONFIG_FILE) ----
def lazygit_yaml(ctx: Ctx, p: Pal) -> str:
    a = p.a
    border = p.status_bg if p.device else p.purple
    return header(ctx, extra=f"Machine: {p.device or 'base'}.") + f"""gui:
  theme:
    activeBorderColor: ['{lower(border)}', bold]
    inactiveBorderColor: ['{lower(p.comment)}']
    searchingActiveBorderColor: ['{lower(a['yellow'])}', bold]
    optionsTextColor: ['{lower(a['cyan'])}']
    selectedLineBgColor: ['{lower(p.selection)}']
    inactiveViewSelectedLineBgColor: ['{lower(p.ui['surface_raised'])}']
    cherryPickedCommitFgColor: ['{lower(a['cyan'])}']
    cherryPickedCommitBgColor: ['{lower(p.selection)}']
    markedBaseCommitFgColor: ['{lower(a['yellow'])}']
    markedBaseCommitBgColor: ['{lower(p.selection)}']
    unstagedChangesColor: ['{lower(a['red'])}']
    defaultFgColor: ['{lower(p.fg)}']
"""


@target("lazygit", "lazygit borders and selection", "runtime", committed=True,
        wiring="lazygit/whc-theme/<machine>.yml, appended to LG_CONFIG_FILE by the zsh and tmux files")
def t_lazygit(ctx):
    devs = ctx.runtime_devices()
    outs = [Out(ctx.root / lazygit_path(ctx, None), lazygit_yaml(ctx, resolve(ctx.theme, ctx.pinned())))]
    for d in devs:
        outs.append(Out(ctx.root / lazygit_path(ctx, d), lazygit_yaml(ctx, resolve(ctx.theme, d))))
    return outs


# ---- Neovim (palette module; plugins/theme.lua feeds it to dracula.nvim; a lualine theme) ----
LUA_KEYWORDS = {"and", "break", "do", "else", "elseif", "end", "false", "for", "function", "goto", "if", "in",
                "local", "nil", "not", "or", "repeat", "return", "then", "true", "until", "while"}


def lua_table(d: dict, ind="    ") -> str:
    parts = []
    for k, v in d.items():
        key = k if re.match(r"^[A-Za-z_][A-Za-z0-9_]*$", k) and k not in LUA_KEYWORDS else f'["{k}"]'
        if isinstance(v, dict):
            parts.append(f"{ind}{key} = {{\n{lua_table(v, ind + '    ')}\n{ind}}},")
        elif v is None:
            continue
        else:
            parts.append(f'{ind}{key} = "{v}",')
    return "\n".join(parts)


def nvim_values(p: Pal) -> dict:
    return {"bg": p.bg, "fg": p.fg, "comment": p.comment, "selection": p.selection, "cursor": p.cursor,
            "status_bg": p.status_bg, "status_fg": p.status_fg, "status2_bg": p.status2_bg, "status2_fg": p.status2_fg,
            "black": p.a["black"], "bright_black": p.a["bright_black"], "dim_black": p.a.get("dim_black", p.a["black"])}


NVIM_BODY = r'''
local function device()
    if M.pinned then
        return M.pinned
    end
    local d = vim.env.WHC_DEVICE
    if not d or d == "" then
        d = (vim.uv or vim.loop).os_gethostname():match("^[^.]+")
    end
    return d and d:lower() or nil
end

--- The palette for this machine: the theme's base colours with the machine's overrides on top.
function M.palette()
    local p = vim.deepcopy(M.base)
    local d = device()
    if d and M.devices[d] then
        p = vim.tbl_extend("force", p, M.devices[d])
        p.device = d
    end
    return p
end

--- dracula.nvim's palette keys (plugins/theme.lua passes this as `colors`).
function M.dracula_colors()
    local p = M.palette()
    local a = p.ansi
    local extra = M.nvim or {}
    return {
        bg = p.bg,
        fg = p.fg,
        selection = p.selection,
        comment = p.comment,
        red = a.red,
        orange = p.orange,
        yellow = a.yellow,
        green = a.green,
        purple = p.purple,
        cyan = a.cyan,
        pink = a.magenta,
        bright_red = a.bright_red,
        bright_green = a.bright_green,
        bright_yellow = a.bright_yellow,
        bright_blue = a.bright_blue,
        bright_magenta = a.bright_magenta,
        bright_cyan = a.bright_cyan,
        bright_white = a.bright_white,
        menu = extra.menu or (M.mode == "dark" and p.dim_black or p.ui.surface_raised),
        visual = extra.visual or p.selection,
        gutter_fg = extra.gutter_fg or p.ui.line_number,
        nontext = extra.nontext or p.ui.border,
        white = extra.white or a.white,
        black = extra.black or (M.mode == "dark" and p.dim_black or p.ui.surface),
    }
end

--- Extra highlights layered over dracula.nvim's groups (cursor, diff rows, float borders, the light-mode fix).
function M.overrides()
    local p = M.palette()
    return {
        Cursor = { fg = p.bg, bg = p.cursor },
        CursorLine = { bg = p.ui.line_highlight },
        DiffAdd = { bg = p.ui.diff_add_bg },
        DiffDelete = { fg = p.ansi.red, bg = p.ui.diff_del_bg },
        FloatBorder = { fg = p.status_bg },
        WinSeparator = { fg = p.ui.border },
    }
end

--- A lualine theme: Normal mode in the machine's colour, the other modes in their usual accents.
function M.lualine()
    local p = M.palette()
    local a = p.ansi
    local bar = M.mode == "dark" and p.dim_black or p.ui.surface
    local function mode(bg, fg)
        return {
            a = { fg = fg or p.bg, bg = bg, gui = "bold" },
            b = { fg = bg, bg = p.ui.surface_raised },
            c = { fg = p.fg, bg = bar },
        }
    end
    return {
        normal = mode(p.status_bg, p.status_fg),
        insert = mode(a.green),
        visual = mode(a.magenta),
        replace = mode(a.yellow),
        command = mode(a.cyan),
        terminal = mode(p.purple),
        inactive = {
            a = { fg = p.comment, bg = bar },
            b = { fg = p.comment, bg = bar },
            c = { fg = p.comment, bg = bar },
        },
    }
end

return M
'''


@target("nvim", "Neovim palette for dracula.nvim, extra highlights, lualine theme", "runtime", committed=True,
        wiring="nvim/lua/whc/theme.lua; nvim/lua/plugins/theme.lua passes it to dracula.nvim, "
               "nvim/lua/lualine/themes/dracula.lua points lualine at it")
def t_nvim(ctx):
    t = ctx.theme
    base = resolve(t, None)
    b = {"bg": base.bg, "fg": base.fg, "comment": base.comment, "selection": base.selection, "cursor": base.cursor,
         "orange": base.orange, "purple": base.purple, "status_bg": base.status_bg, "status_fg": base.status_fg,
         "status2_bg": base.status2_bg, "status2_fg": base.status2_fg, "dim_black": base.a.get("dim_black", base.a["black"]),
         "ansi": base.a, "ui": base.ui, "syntax": base.syntax}
    devs = {}
    for d in ctx.runtime_devices():
        p = resolve(t, d)
        v = nvim_values(p)
        devs[d] = {k: v[k] for k in v if k not in ("black", "bright_black")}
        devs[d]["ansi"] = None
    lines = [header(ctx, prefix="--").rstrip(), "local M = {}", f'M.id = "{t["id"]}"', f'M.name = "{t["name"]}"',
             f'M.mode = "{t["mode"]}"', f'M.pinned = {json.dumps(ctx.pinned()) if ctx.pinned() else "nil"}',
             "M.base = {", lua_table(b), "}", "M.devices = {"]
    for d, v in devs.items():
        lines.append(f"    {d} = {{\n{lua_table(v, '        ')}\n    }},")
    lines.append("}")
    if t.get("nvim"):
        lines += ["M.nvim = {", lua_table(t["nvim"]), "}"]
