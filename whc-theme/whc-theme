def konsole_scheme(p: Pal, description: str) -> str:
    """KDE Konsole .colorscheme (INI). Intense = bright, Faint = dim."""
    def c(h):
        return ",".join(str(x) for x in rgb(h))
    a = p.a
    out = []

    def sect(name, normal, intense, faint):
        out.extend([f"[{name}]", f"Color={c(normal)}", "", f"[{name}Intense]", f"Color={c(intense)}", "",
                    f"[{name}Faint]", f"Color={c(faint)}", ""])
    sect("Background", p.bg, p.bg, p.bg)
    for i, k in enumerate(ORDER8):
        sect(f"Color{i}", a[k], a["bright_" + k], a.get("dim_" + k, mix(a[k], p.bg, 0.3)))
    sect("Foreground", p.fg, a["bright_white"], a.get("dim_white", mix(p.fg, p.bg, 0.3)))
    out += ["[General]", "Anchor=0.5,0.5", "Blur=false", "ColorRandomization=false", f"Description={description}",
            "FillStyle=Tile", "Opacity=1", "Wallpaper=", "WallpaperFlipType=NoFlip", "WallpaperOpacity=1", ""]
    return "\n".join(out)


def ini_get(text: str, section: str, key: str) -> str | None:
    """A key from a KConfig/INI file (first match), or None."""
    cur = None
    for line in text.splitlines():
        st = line.strip()
        if st.startswith("[") and st.endswith("]"):
            cur = st[1:-1]
        elif cur == section and "=" in st and st.split("=", 1)[0].strip() == key:
            return st.split("=", 1)[1].strip()
    return None


def ini_set(text: str, section: str, key: str, value: str) -> str:
    """Set key=value in [section] of a KConfig/INI file, keeping everything else (adds the section if missing)."""
    lines = text.splitlines()
    start = next((i for i, ln in enumerate(lines) if ln.strip() == f"[{section}]"), None)
    if start is None:
        while lines and not lines[-1].strip():
            lines.pop()
        return "\n".join(lines + ([""] if lines else []) + [f"[{section}]", f"{key}={value}"]) + "\n"
    end = next((i for i in range(start + 1, len(lines)) if lines[i].strip().startswith("[")), len(lines))
    for i in range(start + 1, end):
        if "=" in lines[i] and lines[i].split("=", 1)[0].strip() == key:
            lines[i] = f"{key}={value}"
            return "\n".join(lines) + "\n"
    ins = end
    while ins > start + 1 and not lines[ins - 1].strip():
        ins -= 1
    lines.insert(ins, f"{key}={value}")
    return "\n".join(lines) + "\n"


KONSOLE_PROFILE = "WHC.profile"


def konsole_detect(ctx: Ctx) -> bool:
    return bool(shutil.which("konsole")) or (ctx.home / ".local/share/konsole").is_dir()


@target("konsole", "KDE Konsole colour scheme, a WHC profile using it, and that profile as the default", "local",
        wiring="~/.local/share/konsole/WHC.colorscheme and WHC.profile (based on the previous default profile); "
               "~/.config/konsolerc DefaultProfile=WHC.profile (backed up to konsolerc.whc-backup first)",
        detect=konsole_detect)
def t_konsole(ctx):
    p = pal_static(ctx, False)
    data = ctx.home / ".local/share/konsole"
    rc_path = ctx.home / ".config/konsolerc"
    scheme = header(ctx) + konsole_scheme(p, f"WHC {p.name}")
    rc = rc_path.read_text() if rc_path.exists() else ""
    prof_path = data / KONSOLE_PROFILE
    if prof_path.exists():
        prof = prof_path.read_text()
    else:  # start from the profile that was the default, so its font and size carry over
        prev = ini_get(rc, "Desktop Entry", "DefaultProfile")
        prev_path = data / prev if prev and prev != KONSOLE_PROFILE else None
        prof = prev_path.read_text() if prev_path and prev_path.is_file() else "[General]\nParent=FALLBACK/\n"
    prof = ini_set(prof, "Appearance", "ColorScheme", "WHC")
    prof = ini_set(prof, "General", "Name", "WHC")
    rc = ini_set(rc, "Desktop Entry", "DefaultProfile", KONSOLE_PROFILE)
    return [Out(data / "WHC.colorscheme", scheme),
            Out(prof_path, prof),
            Out(rc_path, rc, backup=True, note="new Konsole windows use the WHC profile")]


