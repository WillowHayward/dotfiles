    for t in themes.values():
        devs = list(t.get("devices", {}))
        tint = "tinted" if devs and "background" in t["devices"][devs[0]] else "segment only"
        print(f"{t['id']:<26} {t['mode']:<6} {t['name']:<24} {len(devs)} machines ({tint})")
        if args.devices:
            for d in devs:
                v = t["devices"][d]
                print(f"    {d:<9} status {v['status_bg']}  bg {v.get('background', t['background'])}")


def cmd_targets(args):
    for t in TARGETS.values():
        mark = "*" if t.committed else ("m" if t.detect else " ")
        print(f"{mark} {t.name:<17} {t.kind:<8} {t.desc}")
        print(f"  {'':<17} {'':<8} -> {t.wiring}")
    print("\n* = wired into the dotfiles and applied by default (also `--targets dotfiles`);")
    print("m = in `--targets machine` when the app is installed here; others need --targets (or `export`).")
    print("kinds: runtime = picks the machine when it loads; shared = one file in the dotfiles (auto -> base);")
    print("       local = a file outside the dotfiles (auto -> this machine); system = runs a command (gsettings);")
    print("       print = stdout only (use export).")


def cmd_current(args, themes):
    root = Path(args.root).expanduser() if args.root else default_root()
    repo = read_toml_simple(repo_state_path(root))
    local = read_toml_simple(state_path())
    dev = detect_device()
    print(f"dotfiles   {root}")
    print(f"rendered   {repo.get('theme', '?')} (variant {repo.get('variant', '?')}) per {repo_state_path(root)}")
    if local:
        print(f"this host  {local.get('theme')} (variant {local.get('variant')}), applied {local.get('applied')}"
              f" -> {', '.join(local.get('targets', []))}  [{state_path()}]")
    else:
        print(f"this host  never applied here ({state_path()} missing)")
    tid = repo.get("theme") or local.get("theme")
    known = tid in themes and dev in themes[tid].get("devices", {})
    print(f"machine    {dev or '?'} (WHC_DEVICE={os.environ.get('WHC_DEVICE', '')!s}) "
          f"{'has a variant' if known else 'uses the base variant'}")
    print(f"env        WHC_THEME={os.environ.get('WHC_THEME', '')}")


def render(ctx: Ctx, tlist: list[Target]) -> list[tuple[Target, Out]]:
    out = []
    for t in tlist:
        for o in t.render(ctx):
            out.append((t, o))
    return out


def cmd_apply(args, themes):
    t = pick_theme(themes, args.theme)
    variant = check_variant(t, args.variant)
    root = Path(args.root).expanduser() if args.root else default_root()
    home = Path(args.home).expanduser() if getattr(args, "home", None) else Path.home()
    ctx = Ctx(t, variant, root, home)
    tlist = selected_targets(args.targets, ctx)
    if any(tg.committed for tg in tlist) and not (root / "shell/.tmux.conf").exists():
        sys.exit(f"whc-theme: {root} does not look like the dotfiles repo (use --root or WHC_DOTFILES_DIR)")
    changed, same, written, commands = [], [], [], []
    for tg, o in render(ctx, tlist):
        if o.run:
            commands.append((tg, o))
            continue
        if o.path is None:
            print(f"# {tg.name}: stdout only; use `whc-theme export {tg.name}`", file=sys.stderr)
            continue
        if o.block and not o.create and not o.path.exists():
            print(f"skip {o.path}: managed block needs the file to exist", file=sys.stderr)
            continue
        new = final_content(o, tg.name)
        old = o.path.read_text() if o.path.exists() else None
        rel = o.path.relative_to(root) if o.path.is_relative_to(root) else o.path
        if old == new:
            same.append(str(rel))
            continue
        changed.append(f"{'new ' if old is None else 'edit'} {rel}{'  (' + o.note + ')' if o.note else ''}")
        if not args.dry_run:
            o.path.parent.mkdir(parents=True, exist_ok=True)
            bak = o.path.with_name(o.path.name + ".whc-backup")
            if o.backup and old is not None and not whc_written(old) and not bak.exists():
                shutil.copy2(o.path, bak)
                changed.append(f"     backup {bak}")
            tmp = o.path.with_name(o.path.name + ".whc-tmp")
            tmp.write_text(new)
            os.replace(tmp, o.path)
            written.append(str(o.path))
    for tg, o in commands:
        for cmd in o.run:
            if args.dry_run:
                changed.append(f"run  {' '.join(cmd)}")
                continue
            try:
                r = subprocess.run(cmd, capture_output=True, text=True, timeout=30)
                ok, err = r.returncode == 0, (r.stderr or "").strip()
            except (OSError, subprocess.TimeoutExpired) as e:
                ok, err = False, str(e)
            changed.append(f"{'ran ' if ok else 'FAIL'} {' '.join(cmd)}{'' if ok else '  (' + err + ')'}")
    verb = "would change" if args.dry_run else "changed"
    nfiles = len([c for c in changed if not c.startswith(("run", "ran", "FAIL", "     backup"))])
    print(f"whc-theme {ctx.label()} -> {', '.join(tg.name for tg in tlist) or 'no targets'}: "
          f"{verb} {nfiles}, unchanged {len(same)}")
    for c in changed:
        print("  " + c)
    if args.dry_run:
        return
    names = [tg.name for tg in tlist]
    if any(tg.committed for tg in tlist):
        write_toml_simple(repo_state_path(root), {"theme": t["id"], "variant": variant},
                          "whc-theme: the theme the files in this repo are rendered with. Written by `whc-theme apply`.")
    write_toml_simple(state_path(), {"theme": t["id"], "variant": variant, "device": detect_device() or "",
                                     "root": str(root), "targets": names,
                                     "applied": _dt.datetime.now().isoformat(timespec="seconds")},
                      "whc-theme: what was last applied on this machine. Written by `whc-theme apply`.")
    print("Reload: new shells and tmux (prefix r) pick it up; foot reads its config per window; `makoctl reload`; "
          "`hyprctl reload`; Neovim, Walker, Konsole and Firefox on restart.")


def cmd_export(args, themes):
    root = Path(args.root).expanduser() if args.root else default_root()
    t = pick_theme(themes, args.theme or current_theme_id(root, themes))
    home = Path(args.home).expanduser() if getattr(args, "home", None) else Path.home()
    ctx = Ctx(t, check_variant(t, args.variant), root, home)
    if args.target not in TARGETS:
        sys.exit(f"whc-theme: unknown target {args.target!r}; see `whc-theme targets`")
    outs = TARGETS[args.target].render(ctx)
    for o in outs:
        if len(outs) > 1:
            print(f"# ==> {o.path} <==")
        print(o.content, end="")


def cmd_preview(args, themes):
    root = Path(args.root).expanduser() if args.root else default_root()
    ids = [args.theme] if args.theme else [current_theme_id(root, themes)]
    if args.theme == "all":
        ids = list(themes)
    for tid in ids:
        t = pick_theme(themes, tid)
        v = check_variant(t, args.variant)
        dev = detect_device() if v == "auto" else (None if v == "base" else v)
        p = resolve(t, dev if dev in t.get("devices", {}) else None)
        print(preview_text(p))


def fgc(h):
    r, g, b = rgb(h)
    return f"\x1b[38;2;{r};{g};{b}m"


def bgc(h):
    r, g, b = rgb(h)
    return f"\x1b[48;2;{r};{g};{b}m"


def preview_text(p: Pal) -> str:
    R = "\x1b[0m"
    B = bgc(p.bg)
    a, s = p.a, p.syntax
    w = 64

    def line(txt="", visible=0):
        return B + fgc(p.fg) + " " + txt + B + " " * max(0, w - visible - 1) + R

    rows = [bgc(p.status_bg) + fgc(p.status_fg) + f" {p.device or 'base'} " + bgc(p.status2_bg) + fgc(p.status2_fg)
            + f" {p.name} " + B + " " * max(0, w - len(p.device or 'base') - len(p.name) - 4) + R]
    sw = "".join(bgc(a[k]) + "    " for k in ORDER8)
    sw2 = "".join(bgc(a["bright_" + k]) + "    " for k in ORDER8)
    rows += [line(), line(sw + B, 32), line(sw2 + B, 32), line()]
    code = (fgc(s["keyword"]) + "def " + fgc(s["function"]) + "greet" + fgc(s["punctuation"]) + "("
            + fgc(s["parameter"]) + "name" + fgc(s["punctuation"]) + ": " + fgc(s["type"]) + "str" + fgc(s["punctuation"])
            + ") -> " + fgc(s["type"]) + "str" + fgc(s["punctuation"]) + ":")
    rows.append(line(code, 32))
    code2 = ("    " + fgc(s["keyword"]) + "return " + fgc(s["string"]) + 'f"hi {name}" ' + fgc(s["operator"]) + "* "
             + fgc(s["number"]) + "3  " + "\x1b[3m" + fgc(s["comment"]) + "# a comment" + "\x1b[23m")
    rows.append(line(code2, 38))
    rows.append(line(bgc(p.ui["diff_add_bg"]) + fgc(a["green"]) + "+ added line   " + B + " "
                     + bgc(p.ui["diff_del_bg"]) + fgc(a["red"]) + "- removed line " + B, 31))
    rows.append(line(bgc(p.selection) + fgc(p.fg) + " selected text " + B + " " + fgc(a["bright_black"])
                     + "autosuggestion" + fgc(p.comment) + "  comment", 46))
    rows.append(line())
    return "\n".join(rows)


def cmd_data_sync(args):
    """Copy theme data from a whc-theme checkout (or a data/ dir), e.g. into the dotfiles' vendored copy."""
    src = Path(args.src).expanduser()
    if (src / "data/index.json").exists():
        src = src / "data"
    if not (src / "index.json").exists():
        sys.exit(f"whc-theme: {src} has no index.json (pass a whc-theme checkout or its data/ dir; "
                 "the brand repo is synced with whc-theme's scripts/sync-data)")
    dest = Path(args.dest).expanduser() if args.dest else TOOL_DIR / "data"
    if dest.resolve() == src.resolve():
        sys.exit("whc-theme: source and destination are the same")
    ids = json.loads((src / "index.json").read_text())["themes"]
    if dest.exists():
        shutil.rmtree(dest)
    dest.mkdir(parents=True)
    for tid in ids:
        shutil.copy2(src / f"{tid}.json", dest / f"{tid}.json")
    shutil.copy2(src / "index.json", dest / "index.json")
    print(f"synced {len(ids)} themes from {src} into {dest}")


def main(argv=None):
    ap = argparse.ArgumentParser(prog="whc-theme", description="Render WHC colour themes into configs.")
    ap.add_argument("--list-targets", action="store_true", help="same as `whc-theme targets`")
    ap.add_argument("--version", action="version", version=VERSION)
    sub = ap.add_subparsers(dest="cmd")
    s = sub.add_parser("list", help="list themes")
    s.add_argument("--devices", action="store_true")
    sub.add_parser("targets", help="list targets")
    s = sub.add_parser("current", help="show the applied theme")
    s.add_argument("--root")
    s = sub.add_parser("apply", help="render and write the targets")
    s.add_argument("theme")
    s.add_argument("--variant", default="auto")
    s.add_argument("--targets", help="comma-separated names, or `all` for every file target")
    s.add_argument("--dry-run", action="store_true")
    s.add_argument("--root", help="dotfiles root (default: the repo this tool is in, else $WHC_DOTFILES_DIR or ~/dotfiles)")
    s.add_argument("--home", help="home directory for local targets (default: ~)")
    s = sub.add_parser("export", help="print one target")
    s.add_argument("target")
    s.add_argument("--theme")
    s.add_argument("--variant", default="auto")
    s.add_argument("--root")
    s.add_argument("--home")
    s = sub.add_parser("preview", help="ANSI preview")
    s.add_argument("theme", nargs="?", help="a theme id, or `all`")
    s.add_argument("--variant", default="auto")
    s.add_argument("--root")
    s = sub.add_parser("data-sync", help="copy theme data from a whc-theme checkout")
    s.add_argument("--from", dest="src", required=True)
    s.add_argument("--dest")
    args = ap.parse_args(argv)
    if args.list_targets or args.cmd == "targets":
        return cmd_targets(args)
    if args.cmd == "data-sync":
        return cmd_data_sync(args)
    themes = load_themes()
    if args.cmd == "list":
        return cmd_list(args, themes)
    if args.cmd == "current":
        return cmd_current(args, themes)
    if args.cmd == "apply":
        return cmd_apply(args, themes)
    if args.cmd == "export":
        return cmd_export(args, themes)
    if args.cmd == "preview":
        if args.theme and args.theme != "all":
            pick_theme(themes, args.theme)
        return cmd_preview(args, themes)
    ap.print_help()


if __name__ == "__main__":
    main()
