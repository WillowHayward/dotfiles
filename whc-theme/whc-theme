# --- managed-block files --------------------------------------------------------------------------------
def splice_block(existing: str, body: str, comment="#", before_first_section=False, close="") -> str:
    begin = f"{comment} {MARK_BEGIN}{close}"
    end = f"{comment} {MARK_END}{close}"
    note = f"{comment} Generated by whc-theme; edit the theme, not these lines (`whc-theme apply <theme>`).{close}"
    block = f"{begin}\n{note}\n{body}{end}\n"
    pat = re.compile(re.escape(begin) + r".*?" + re.escape(end) + r"\n?", re.S)
    if pat.search(existing):
        return pat.sub(lambda _m: block, existing, count=1)
    if before_first_section:
        lines = existing.splitlines(keepends=True)
        for i, line in enumerate(lines):
            if line.startswith("["):
                return "".join(lines[:i]) + block + "\n" + "".join(lines[i:])
    sep = "" if existing.endswith("\n\n") or not existing else ("\n" if existing.endswith("\n") else "\n\n")
    return existing + sep + block


def final_content(o: Out, tname: str) -> str:
    if not o.block:
        return o.content
    existing = o.path.read_text() if o.path and o.path.exists() else ""
    return splice_block(existing, o.content, comment=o.comment[0], close=o.comment[1],
                        before_first_section=(tname == "mako"))


# --- state ------------------------------------------------------------------------------------------------
def state_path() -> Path:
    env = os.environ.get("WHC_THEME_STATE")
    if env:
        return Path(env).expanduser()
    base = os.environ.get("XDG_STATE_HOME") or str(Path.home() / ".local/state")
    return Path(base) / "whc/theme.toml"


def read_toml_simple(path: Path) -> dict:
    """Flat key = "value" / [list] TOML (all whc-theme writes); tomllib when available."""
    if not path.exists():
        return {}
    try:
        import tomllib  # Python 3.11+
        return tomllib.loads(path.read_text())
    except ModuleNotFoundError:
        out = {}
        for line in path.read_text().splitlines():
            m = re.match(r'^\s*([A-Za-z_][\w-]*)\s*=\s*(.+?)\s*$', line)
            if m:
                v = m.group(2)
                out[m.group(1)] = json.loads(v) if v[:1] in '"[' else v
        return out


def write_toml_simple(path: Path, data: dict, comment: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    lines = [f"# {c}" for c in comment.splitlines()]
    for k, v in data.items():
        lines.append(f"{k} = {json.dumps(v)}")
    path.write_text("\n".join(lines) + "\n")


def repo_state_path(root: Path) -> Path:
    return root / "whc-theme/theme.toml"


