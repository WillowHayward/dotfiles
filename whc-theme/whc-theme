TOOL = Path(__file__).resolve()
TOOL_DIR = TOOL.parent
VERSION = "1.1.0"
DEVICES = ["bessie", "ranch", "ship", "cowgirl", "deborah", "felicia", "dowager", "mermaid", "sailor"]
ORDER8 = ["black", "red", "green", "yellow", "blue", "magenta", "cyan", "white"]
BESPOKE = ["meadow-night", "meadow-day", "dracula-meadow"]
MARK_BEGIN = ">>> whc-theme >>>"
MARK_END = "<<< whc-theme <<<"
