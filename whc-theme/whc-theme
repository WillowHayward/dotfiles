FIREFOX_ROOTS = [".config/mozilla/firefox", ".mozilla/firefox", ".var/app/org.mozilla.firefox/.mozilla/firefox",
                 "snap/firefox/common/.mozilla/firefox"]


def firefox_profiles(home: Path) -> list[Path]:
    """Profiles to theme: $WHC_FIREFOX_PROFILE, else every profile in profiles.ini that has been used (prefs.js)."""
    env = os.environ.get("WHC_FIREFOX_PROFILE")
    if env:
        return [Path(env).expanduser()]
    out = []
    for r in FIREFOX_ROOTS:
        root = home / r
        ini = root / "profiles.ini"
        if not ini.is_file():
            continue
        cur: dict = {}
        sections = []
        for line in ini.read_text(errors="replace").splitlines() + ["[end]"]:
            st = line.strip()
            if st.startswith("["):
                if cur.get("Path"):
                    sections.append(cur)
                cur = {}
            elif "=" in st:
                k, v = st.split("=", 1)
                cur[k.strip()] = v.strip()
        for sec in sections:
            path = root / sec["Path"] if sec.get("IsRelative", "1") == "1" else Path(sec["Path"])
            if (path / "prefs.js").is_file() and path not in out:
                out.append(path)
    return out


